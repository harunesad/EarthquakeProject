--- !u!114 &1933438515
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1933438513}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 86c9cb932c889704cba9d87e44645e2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  answers: []
  objectInfo: {fileID: 248710783}
  turn: {fileID: 0}
  player: {fileID: 0}
  infos:
  - "Merhaba! Ho\u015F geldin! Birlikte eglenmeye ve \xF6grenmeye haz\u0131r m\u0131s\u0131n? 
    Benim ad\u0131m Alice! Nas\u0131l yapar\u0131m bunu? Aray\u0131p bulmal\u0131y\u0131m,
    \xE7\u0131k\u0131\u015F yolunu! \u0130nand\u0131m kendime ve denedim. S\xFCrekli
    \xE7abalad\u0131m! Sonunda, buldum \xE7\u0131k\u0131\u015F yolunu! \xC7\xFCnk\xFC
    benim ad\u0131m Alice!  Hadi! Ba\u015Flayal\u0131m."
  - "Deprem \xE7antan\u0131 yan\u0131nda ald\u0131g\u0131ndan emin misin?"
  - "Tebrikler! Ba\u015Fard\u0131k! Deprem \xE7antam\u0131z\u0131n hangisi oldugunu
    ve \xF6nemini \xF6grendik!"
  - "Deprem oluyor! G\xFCvenli bir alana ge\xE7! Deprem oldugunda hemen yere \xE7\xF6k,
    ba\u015F\u0131n\u0131 ve boynunu koruyacak \u015Fekilde kapan, ve g\xFCvenli
    bir yere s\u0131k\u0131ca tutun! Senin i\xE7in yukar\u0131da \xE7\xF6k-kapan-tutun
    hareketini nas\u0131l yapabilecegini g\xF6sterdim! Hadi!"
  - "Depremi hasars\u0131z atlatt\u0131k. Depreme haz\u0131rl\u0131kl\u0131 olmak
    \xE7ok \xF6nemli! Deprem \xE7antas\u0131n\u0131n i\xE7inde olmas\u0131 gereken
    baz\u0131 \xF6nemli e\u015Fya ve malzemeleri birlikte se\xE7elim. Dogru malzemeleri
    se\xE7tigimizden emin olmal\u0131y\u0131z. Haz\u0131r m\u0131s\u0131n?"
  - "Ba\u015Fard\u0131k, tebrikler! Depreme kar\u015F\u0131 art\u0131k daha da haz\u0131rl\u0131kl\u0131y\u0131z!
    Hadi, gel! Okula gitme zaman\u0131!"
  injuredBird: {fileID: 10913, guid: 0000000000000000f000000000000000, type: 0}

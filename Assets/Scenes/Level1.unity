  falseSelect: {fileID: 8300000, guid: aa15507cd42aeda4b8d6dee770e21053, type: 3}
  finish: {fileID: 0}
  earthquakeInfo: "Deprem ve Acil Durum \xC7antas\u0131, deprem gibi beklenmedik
    durumlarda, acil yard\u0131m ekipleri bize ula\u015Fana kadar hayati ihtiya\xE7lar\u0131m\u0131z\u0131
    ve \xF6nemli evraklar\u0131m\u0131z\u0131 saklayabilecegimiz bir \xE7antad\u0131r.
    Bu \xE7anta, afet sonras\u0131 ilk 72 saatte bizim ve sevdiklerimizin hayat\u0131n\u0131
    kolayla\u015Ft\u0131rmak i\xE7in kritik \xF6neme sahiptir."
  bagInfo: "\u2003Deprem \xE7antas\u0131 i\xE7inde olmas\u0131 gerekenler: Su, bisk\xFCvi,
    \xE7ikolata, \xE7abuk \xE7orba, konserve yiyecek, kuru yemi\u015F gibi \xE7abuk
    bozulmayan g\u0131dalar, metal d\xFCd\xFCk (d\xFCd\xFCk hijyen a\xE7\u0131s\u0131ndan
    po\u015Fette saklanmal\u0131), fener, yedek pil, stre\xE7 film, elektronik ve
    diger laz\u0131m olabilecek e\u015Fyalar (k\u0131yafet, radyo, powerbank), ilk
    yard\u0131m malzemeleri ve toz maskesi (Yara band\u0131,sarg\u0131 bezi vb.),
    hijyen malzemeleri, isvi\xE7re \xE7ak\u0131s\u0131, kimlik, pasaport, banka c\xFCzdan
    fotokopisi, araban\u0131n yedek anahtar\u0131, ila\xE7 kullananlar i\xE7in yedekler"
  apply: {fileID: 21300000, guid: 34cbb61f7cd90d04cbf9f4355fa14be7, type: 3}
  close: {fileID: 21300000, guid: a6b63c8e196f9ea4e854697bdcd296e1, type: 3}

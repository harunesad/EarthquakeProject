--- !u!114 &559242427
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 559242426}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 86c9cb932c889704cba9d87e44645e2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  answers:
  - {fileID: 1240168503}
  - {fileID: 86169728}
  - {fileID: 650192555}
  - {fileID: 1555371922}
  objectInfo: {fileID: 0}
  turn: {fileID: 0}
  player: {fileID: 0}
  infos:
  - "Okula, geldik! Unutma! Deprem dogal bir afettir. Her zaman, her yerde haz\u0131rl\u0131kl\u0131
    olmak \xF6nemlidir. Okulda, s\u0131n\u0131f i\xE7erisinde, deprem an\u0131nda
    \xF6gretmenlerimizin talimatlar\u0131n\u0131 dinlemeliyiz."
  - "Deprem oldu! Sars\u0131nt\u0131 bitti! Hemen s\u0131n\u0131fta g\xFCvenli bir
    alan\u0131 se\xE7, ya\u015Fam \xFC\xE7geni olu\u015Ftur ve cenin pozisyonunda
    kal!"
  - "Deprem sonras\u0131nda s\u0131n\u0131f\u0131 terk ederken panik yapmadan, s\u0131ran\u0131z\u0131
    koruyarak ve \xF6gretmeninizin talimatlar\u0131n\u0131 dinleyerek d\xFCzenli
    bir \u015Fekilde bah\xE7eye \xE7\u0131kmal\u0131s\u0131n\u0131z. Okulunuzun bah\xE7esi
    ayn\u0131 zamanda g\xFCvenli bir toplanma alan\u0131d\u0131r. Bu s\xF6ylediklerimi
    unutma! S\u0131n\u0131ftan dogru talimatlarla \xE7\u0131kmam\u0131z gerekiyor!
    Talimatlar\u0131 dogru bir \u015Fekilde se\xE7ebilirsen, g\xF6rev ba\u015Far\u0131l\u0131
    olacak! Hadi ba\u015Flayal\u0131m!"
  - "S\u0131n\u0131ftan ba\u015Far\u0131l\u0131 bir \u015Fekilde ayr\u0131ld\u0131k!
    Tebrikler! \u015Eimdi bilgilerimizi eglenceli bir bilgi yar\u0131\u015Fmas\u0131
    ile peki\u015Ftirme zaman\u0131! Haz\u0131rsan ba\u015Fl\u0131yoruz!"
  - "S\u0131n\u0131ftan basar\u0131l\u0131 bir sekilde ayr\u0131ld\u0131k! Tebrikler!
    Simdi bilgilerimizi eglenceli bir bilgi yar\u0131smas\u0131 ile pekistirme zaman\u0131!
    Haz\u0131rsan basl\u0131yoruz!"
  injuredBird: {fileID: 10913, guid: 0000000000000000f000000000000000, type: 0}
  level1Manager: {fileID: 0}
  level2UIManager: {fileID: 1101071606}
  competition:
  - question: "Deprem olunca ilk ne yapmal\u0131y\u0131z?"
    answers:
    - "Ko\u015Farak d\u0131\u015Far\u0131 \xE7\u0131kmal\u0131y\u0131z"
    - "\xC7\xF6k, kapan, tutun yapmal\u0131y\u0131z"
    - "Camdan d\u0131\u015Far\u0131 \xE7\u0131kmal\u0131y\u0131z"
    - "Saklamba\xE7 oynamal\u0131y\u0131z"
    correctAnswerId: 1
  - question: "Deprem s\u0131ras\u0131nda nerede durmal\u0131y\u0131z?"
    answers:
    - "B\xFCy\xFCk ve saglam bir nesnenin yan\u0131na ge\xE7meliyiz"
    - "Pencerenin \xF6n\xFCnde durmal\u0131y\u0131z"
    - "Balkona \xE7\u0131kmal\u0131y\u0131z"
    - "Merdivenlere ko\u015Fmal\u0131y\u0131z"
    correctAnswerId: 0
  - question: "Deprem oldugunda nas\u0131l hissetmeliyiz?"
    answers:
    - "Hoplay\u0131p z\u0131plamal\u0131y\u0131z"
    - "Saklanmal\u0131y\u0131z ve kimseye haber vermemeliyiz"
    - "Sakin, sogukkanl\u0131 davranmal\u0131 ve dikkatli olmal\u0131y\u0131z"
    - "Bag\u0131rarak ko\u015Fmal\u0131y\u0131z"
    correctAnswerId: 2
  - question: "Ya\u015Fam \xFC\xE7geni olu\u015Ftururken hangi hareketi yapmal\u0131s\u0131n?"
    answers:
    - "Ko\u015Farak s\u0131n\u0131f\u0131 terk etmek"
    - "Masa veya saglam bir e\u015Fyan\u0131n yan\u0131na \xE7\xF6melip ba\u015F\u0131n\u0131
      korumak"
    - "Pencereden d\u0131\u015Far\u0131 bakmak"
    - Sandalyede oturmak
    correctAnswerId: 1
  - question: "Deprem olduktan sonra d\u0131\u015Far\u0131 \xE7\u0131kmam\u0131z
      ne zaman g\xFCvenlidir?"
    answers:
    - Hemen
    - 'Geceleri '
    - "Uyand\u0131g\u0131m\u0131zda"
    - "Deprem bitince, \xF6gretmenimizin veya b\xFCy\xFCg\xFCm\xFCz\xFCn s\xF6ylemesini
      bekleriz"
    correctAnswerId: 3
  - question: "Ya\u015Fam \xFC\xE7geni olu\u015Fturulacak en g\xFCvenli yer neresi
      olabilir?"
    answers:
    - "B\xFCy\xFCk bir pencerenin \xF6n\xFC"
    - "Raflar\u0131n ve dolaplar\u0131n alt\u0131"
    - "Saglam bir mobilyan\u0131n yan\u0131ndaki alan"
    - "Kap\u0131n\u0131n hemen \xF6n\xFC"
    correctAnswerId: 2
  - question: "Deprem olmadan \xF6nce evde hangi g\xFCvenlik \xF6nlemlerini almal\u0131y\u0131z?"
    answers:
    - "Ag\u0131r e\u015Fyalar\u0131 yukar\u0131 raflara koymal\u0131y\u0131z"
    - "E\u015Fyalar\u0131 sabitlemeli ve ka\xE7\u0131\u015F yollar\u0131n\u0131 a\xE7\u0131k
      b\u0131rakmal\u0131y\u0131z"
    - "Pencerelerin \xF6n\xFCne b\xFCy\xFCk e\u015Fyalar koymal\u0131y\u0131z"
    - "T\xFCm e\u015Fyalar\u0131 odan\u0131n ortas\u0131na yerle\u015Ftirmeliyiz"
    correctAnswerId: 1
  - question: "Deprem \xE7antas\u0131nda neden d\xFCd\xFCk olmal\u0131d\u0131r?"
    answers:
    - "Oyun oynamak i\xE7in"
    - "\u015Eark\u0131 s\xF6ylemek i\xE7in"
    - "Acil durumda sesimizi duyurmak i\xE7in"
    - "Arkada\u015Flar\u0131m\u0131z\u0131 \xE7ag\u0131rmak i\xE7in"
    correctAnswerId: 2
  - question: "Deprem \xE7antam\u0131z\u0131 nerede saklamal\u0131y\u0131z?"
    answers:
    - "Kolay ula\u015F\u0131labilecek bir yerde"
    - "En \xFCst raf\u0131n arkas\u0131nda"
    - "Kilitli bir dolab\u0131n i\xE7inde"
    - "Bah\xE7ede topraga g\xF6m\xFCl\xFC"
    correctAnswerId: 0
  aliceClips:
  - {fileID: 8300000, guid: 31f8100545c316c4fae76443d8b92116, type: 3}
  - {fileID: 8300000, guid: 6b2521d4aee8dbf4a990d7cc42947440, type: 3}

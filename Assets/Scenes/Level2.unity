  falseSelect: {fileID: 8300000, guid: aa15507cd42aeda4b8d6dee770e21053, type: 3}
  safe: {fileID: 0}
  notSafe: {fileID: 0}
  earthquakeInfo: "Deprem s\u0131ras\u0131nda hayatta kalmak i\xE7in saglam bir nesnenin
    yan\u0131nda ya\u015Fam \xFC\xE7geni olu\u015Fturulmal\u0131 ve cenin pozisyonunda
    durulmal\u0131d\u0131r. Yatak kenar\u0131, s\u0131ra, koltuk veya masa yanlar\u0131
    g\xFCvenli alanlard\u0131r. \xC7ama\u015F\u0131r makinesi gibi sabit olmayan
    e\u015Fyalar\u0131n ve masan\u0131n alt\u0131nda durmak tehlikelidir. Ya\u015Fam
    \xFC\xE7genini, dayan\u0131kl\u0131 ve ezilmeyecek bir nesnenin yan\u0131nda
    olu\u015Fturmak hayati \xF6nem ta\u015F\u0131r."
  lifeInfo: "Ya\u015Fam \xFC\xE7geni olu\u015Fturacag\u0131m\u0131z yerlerde su,
    d\xFCd\xFCk, \xE7ikolata tarz\u0131 ufak bir deprem po\u015Feti olmal\u0131d\u0131r.
    Olu\u015Fturdugumuz ya\u015Fam \xFC\xE7geninde cenin pozisyonunda durmal\u0131y\u0131z.
    Cenin pozisyonu, k\xFC\xE7\xFClmemizi saglar ve ezilme ihtimalimizi azalt\u0131r.
    Ya\u015Fam \xFC\xE7genini depreme dayan\u0131kl\u0131 bir e\u015Fyan\u0131n yan\u0131nda
    yapmal\u0131y\u0131z. Masan\u0131n alt\u0131nda durmak risklidir. Dogru olan,
    masan\u0131n yan\u0131nda ya\u015Fam \xFC\xE7geni olu\u015Fturmakt\u0131r."
  alice: {fileID: 577743385}
  player: {fileID: 1437384516}
  selections:
  - {fileID: 759770781}
  - {fileID: 1881961044}
  - {fileID: 1867445990}
  - {fileID: 149707635}
